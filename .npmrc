auto-install-peers=true
strict-peer-dependencies=false

# Expose @prisma/client at the workspace root. On Windows, `prisma generate`
# writes the client to <root>/node_modules/.prisma/client, whose index.d.ts
# imports '@prisma/client/runtime/library.js' — unresolvable from the root
# without this hoist, so every tx client type collapses to `{}` (tsc errors).
# The first two entries restate pnpm's defaults, which this setting replaces.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@prisma/client
